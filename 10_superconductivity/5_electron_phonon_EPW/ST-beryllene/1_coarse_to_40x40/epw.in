--
&inputepw
  prefix      = 'ph'
  outdir      = './tmp'
  iverbosity  = 2

  dvscf_dir = '../../07_phonon_q12_nod3/run01/collect/save/'

  elph = .true.,  ep_coupling = .true.,  epbwrite = .true.,  epbread = .false., ephwrite = .true., epwwrite = .true., epwread = .false., wannierize  = .true.

  nbndsub     = 12
  bands_skipped = 'exclude_bands = 1:3'
  num_iter    = 1000
  dis_froz_max= -1.2522

  proj(1) = 'Be:s;p'

  wdata(1) = 'guiding_centres = true'
  wdata(2) = 'use_ws_distance = .true.'
  wdata(3) = 'bands_plot = .true.'
  wdata(4) = 'begin kpoint_path'
  wdata(5) = 'G 0.000 0.000 0.000 M 0.500 0.500 0.000'
  wdata(6) = 'M 0.500 0.500 0.000 X 0.500 0.000 0.000'
  wdata(7) = 'X 0.500 0.000 0.000 G 0.000 0.000 0.000'
  wdata(8) = 'end kpoint_path'

  eliashberg     = .true.
  laniso         = .false.
  liso           = .true.
  limag          = .true.
  lpade          = .true.
  nsiter         = 500
  conv_thr_iaxis = 1.0d-4


  temps = 0.1

  fsthick     = 0.6
  degaussw    = 0.15
  degaussq    = 0.5
  nqstep      = 500
  wscut       = 1.20
  muc         = 0.13
  lifc        = .true.
  asr_typ     = 'crystal'

  nk1 = 24, nk2 = 24, nk3 = 1
  nq1 = 12, nq2 = 12, nq3 = 1

  mp_mesh_k = .true.
  nkf1 = 40, nkf2 = 40, nkf3 = 1
  nqf1 = 40,  nqf2 = 40,  nqf3 = 1

/
