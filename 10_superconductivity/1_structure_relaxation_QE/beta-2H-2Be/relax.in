&CONTROL
  calculation = 'vc-relax'
  prefix = 'relax'
  outdir = './tmp'
  pseudo_dir = '/software/projects/pawsey0328/hma/apps/quantum-espresso/pseudo/ONCV'
  tprnfor = .true.
  tstress = .true.
  forc_conv_thr = 1.0d-5
  etot_conv_thr = 1.0d-8
  nstep = 300
/
&SYSTEM
  ibrav = 0
  nat = 4
  ntyp = 2
  ecutwfc = 80
  ecutrho = 640
  occupations = 'smearing'
  smearing = 'mv'
  degauss = 0.02
  assume_isolated = '2D'
/
&ELECTRONS
  conv_thr = 1.0d-12
  mixing_beta = 0.4
  diago_full_acc = .true.
/
&IONS
  ion_dynamics = 'bfgs'
/
&CELL
  cell_dynamics = 'bfgs'
  cell_dofree = '2Dxy'
  press_conv_thr = 0.1
/
