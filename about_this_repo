# before commit and push to GitHub repo, run the following code:

MAX=$((95*1024*1024))

git ls-files -m -o --exclude-standard -z | while IFS= read -r -d '' f; do
  [ -e "$f" ] || continue
  size=$(wc -c < "$f" 2>/dev/null || echo 0)
  if [ "$size" -le "$MAX" ]; then
    git add -- "$f"
  else
    echo "skip large: $f ($size bytes)"
  fi
done
