# before commit and push to GitHub repo, run the following code:

MAX=$((95*1024*1024))

git status --porcelain -z | while IFS= read -r -d '' entry; do
  f=${entry:3}
  [ -e "$f" ] || continue
  size=$(wc -c < "$f" 2>/dev/null || echo 0)
  if [ "$size" -le "$MAX" ]; then
    git add -- "$f"
  fi
done
