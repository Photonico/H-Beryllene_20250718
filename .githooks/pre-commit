#!/usr/bin/env bash
set -euo pipefail
MAX=$((65 * 1024 * 1024))     # 65MB
big=0

while IFS= read -r -d '' f; do
  if ! git cat-file -e ":$f" 2>/dev/null; then
    continue
  fi
  size=$(git cat-file -s ":$f")
  if (( size > MAX )); then
    echo "! Unstaging large file (>50MB): $f ($size bytes)"
    git restore --staged -- "$f"
    big=1
  fi
done < <(git diff --cached --name-only -z --diff-filter=AM)
if (( big == 1 )); then
  echo "✔ Large files were unstaged so they won't be committed."
fi
exit 0