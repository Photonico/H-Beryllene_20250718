#### Calculation Information for SC (phonopy forces, PBE consistent with the relaxation)
# Based on 3.5_phonon_dispersion_with_hydrogen_selected INCAR (Lu Niu, May 18, 2023); 2026-09-27: no D3, SIGMA 0.05, KPAR 4

## Project name
SYSTEM = Phonopy

## Start parameters for this Run (default ICHARG = 2 when ISTART = 0; ICHARG = 11 for bandstructure and DOS calculation)

## Electronic optimization (Low, Medium, High, Accurate)
PREC = Accurate
# Projected Density of States and Mulliken population analysis (not needed for phonopy force calculations)
# LORBIT = 11
# Defaults from POTCAR
ENCUT = 600
# Output charge function file CHGCAR
LCHARG = .FALSE.
# Output wave function file WAVECAR
LWAVE = .FALSE.

# Algorithm for electron optimization
IALGO = 38
# or use: ALGO = Fast
# of ELM steps, sometimes default is too small
NELM = 150
# Stopping-criterion for ELM
EDIFF = 1E-8
# Stopping-criterion for IOM (not used here because NSW = 0)
# EDIFFG = -1E-3
# Broadening and DOS related values
SIGMA = 0.05
ISMEAR = 0  # Gaussian Smearing

# Electron Spin (1 for single layer / 2 for double layers)
# ISPIN = 2       # 2 for spin-polarized calculations (collinear) are performed
# Magnetic moment
# MAGMOM = 1

## Ionic relaxation
# Number of steps for IOM
NSW = 0
# No ionic relaxation; static force calculation for phonopy
IBRION = -1
# Step for ionic-motion (for MD in fs)
# POTIM = .5
# Stress tensor (not used here because NSW = 0)
# ISIF = 2

# Performance optimization
# The number of groups made, each group working on one set of k-points
KPAR = 4
# How many cores handling one orbital
NCORE = 6
# Real space projection; for phonon forces prefer full reciprocal-space projection
LREAL = .FALSE.
# Generalized Gradient Approximation (GGA)
GGA = PE
# Include VdW dispersion correction (off: the geometry was relaxed with PBE without D3)
# IVDW = 12
# Symmetry
# ISYM = 0

# Dipole Correction
LDIPOL = .TRUE.             # Dipole correction adjusts forces and potential.
IDIPOL = 3                  # 1 for x direction, 2 for y direction, 3 for z direction, 4 for all 3-dimensions
DIPOL = 0.5 0.5 0.10
# min+(max-min)/2 for Direct coordinates
# (min+(max-min)/2)/Z_lattice for Cartesian coordinates
